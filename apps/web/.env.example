# Nest API base URL (no trailing slash). Used by Next.js rewrites: browser calls /api/* → this host.
# Must match where the API listens (default PORT 5000 in apps/api).
NEXT_PUBLIC_API_URL=http://localhost:5000

# Google Identity Services (Sign in with Google). Must match the OAuth 2.0 Web client ID used by the API (GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Stripe.js (wallet top-up, etc.)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
