# --- Production (Render / Fly.io / Railway) ---
# Set in the host dashboard or `fly secrets set` / Railway Variables (never commit real values).
# Required: DATABASE_URL, REDIS_URL, JWT_SECRET, STRIPE_SECRET_KEY, APP_BASE_URL (public site URL, no trailing slash).
# Webhooks — after the API is reachable over HTTPS:
#   1) Stripe Dashboard → Developers → Webhooks → Add endpoint
#   2) Endpoint URL: https://<your-api-host>/stripe/webhook  (no trailing slash; path is /stripe/webhook)
#   3) Events: subscribe to the types listed in src/stripe/stripe-webhook-events.ts (wallet + subscriptions)
#   4) Reveal the endpoint “Signing secret” (whsec_...) → set as STRIPE_WEBHOOK_SECRET below (and on Render/Fly/Railway).
# Local testing: stripe listen --forward-to localhost:5000/stripe/webhook — paste the CLI whsec_... here.
# Subscriptions: STRIPE_PRICE_ID_* from Stripe Product pricing (monthly recurring price_... IDs).
# Migrations: applied automatically when the API starts (TypeORM migrationsRun in app.module.ts).
# Manual CLI (after `npm run build`): npm run migration:run:prod — requires DATABASE_URL in the environment.

# --- Postgres (required) ---
# Local (docker-compose): postgresql://postgres:postgres@localhost:5432/lead_platform
# Supabase: Project Settings → Database → URI (Session or direct; include ?sslmode=require if prompted).
# If the API host cannot reach IPv6 (Render ENETUNREACH), the API resolves an IPv4 address for the DB
# host at boot (see resolve-postgres-url-ipv4.ts) and sets TLS SNI for Supabase Postgres.
DATABASE_URL=

JWT_SECRET=

# --- Redis (required for Bull queues) ---
# Local: redis://localhost:6379
# Upstash: use the **TLS** URL from the dashboard — must start with rediss:// (not redis://).
# The API enables TLS when the protocol is rediss: (see distribution.module.ts).
REDIS_URL=
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000
# Subscription checkout — get Price IDs from Stripe Dashboard:
# Products → Add product (or open existing) → Pricing → Add price → Recurring (monthly) → Save → copy "Price ID" (price_...).
# Create four monthly recurring prices (or one product with four prices) and map them below.
# Catalog dollar amounts in the app are in SubscriptionsService.planCatalogDefinitions — match Stripe amounts for clarity.
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MARKET_SPECIFIC=
STRIPE_PRICE_ID_PREMIUM=

# Optional: checkout hold duration for POST /leads/:id/reserve (seconds, default 900)

# Optional: cron schedule for wallet auto-reload (default */2 = every 2 minutes). Example: * * * * * = every minute.
AUTO_RELOAD_CRON=*/2 * * * *


